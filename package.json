{
  "name": "medicard-ge",
  "version": "1.0.0",
  "private": true,
  "description": "Medicard.GE — Georgian-language AI medical assistant (Expo + Express + Neon)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix mobile install",
    "db:push": "npm --prefix server run prisma:push",
    "db:studio": "npm --prefix server run prisma:studio",
    "server": "npm --prefix server run dev",
    "mobile": "npm --prefix mobile run start",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:clean": "npm --prefix mobile run start:clean",
    "mobile:web:clean": "npm --prefix mobile run web:clean",
    "test:api": "node server/scripts/smoke.js",
    "sync:pharmacy": "node server/scripts/sync-pharmacy-prices.js",
    "assign:pharmacy-categories": "node server/scripts/assign-pharmacy-categories.js",
    "backfill:pharmacy-categories": "node server/scripts/backfill-pharmacy-categories-from-pd.js",
    "merge:pharmacy-duplicates": "node server/scripts/merge-pharmacy-duplicates.js",
    "test:ai": "node --experimental-default-type=module server/scripts/check-evidencemd.js",
    "typecheck": "npm --prefix mobile run typecheck",
    "build": "npm --prefix server ci --include=dev && npm --prefix server run prisma:generate && npm --prefix mobile ci --include=dev && npm --prefix mobile run export:web && node -e \"const fs=require('fs');const p='server/admin/index.html'; if(!fs.existsSync(p)){console.error('Missing '+p); process.exit(1)} console.log('admin ui ok')\"",
    "release": "npm --prefix server run prisma:push && npm --prefix server run seed",
    "start": "npm --prefix server start",
    "clean": "node scripts/clean.mjs",
    "figma:sync": "node scripts/figma/sync.mjs",
    "figma:auth": "node scripts/figma/sync.mjs --export-auth",
    "figma:onboarding": "node scripts/figma/export-onboarding.mjs",
    "figma:welcome": "node scripts/figma/export-welcome-all.mjs",
    "figma:welcome:verify": "node scripts/figma/verify-welcome-assets.mjs",
    "figma:assessment": "node scripts/figma/export-assessment-all.mjs",
    "figma:assessment:svg": "node scripts/figma/import-assessment-svg.mjs",
    "figma:illustration:svg": "node scripts/figma/import-illustration-svg.mjs",
    "figma:body:svg": "node scripts/figma/import-body-svg.mjs"
  }
}
