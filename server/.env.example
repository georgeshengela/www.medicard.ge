NODE_ENV=development
PORT=4000

# Neon PostgreSQL — use the *pooled* (-pooler) host for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

JWT_SECRET="a-long-random-string"
JWT_EXPIRES_IN="30d"

# EvidenceMD — OpenAI-compatible clinical reasoning endpoint (chat)
EVIDENCEMD_API_KEY="emd_..."
EVIDENCEMD_BASE_URL="https://evidencemd.ai/api/v1"
EVIDENCEMD_MODEL="evidencemd-pro"

# OpenRouter — default Medi engine is Gemini Flash; EvidenceMD is an optional clinical path
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-3.8-flash"

# Optional direct vision fallbacks
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

FREE_DAILY_AI_LIMIT=3

# Admin panel (/admin). Required when creating the first admin in production.
# Seed never rotates an existing admin password on deploy.
ADMIN_EMAIL="admin@medicard.ge"
ADMIN_PASSWORD="MedicardAdmin1!"
ADMIN_FULL_NAME="Medicard Admin"

# Resend — password reset emails (noreply@medicard.ge)
RESEND_API_KEY=""
RESEND_FROM="Medicard <noreply@medicard.ge>"

# SMSOffice.ge — OTP and admin SMS (sender must be registered, e.g. MEDICARD)
SMS_OFFICE_API_KEY=""
SMS_OFFICE_SENDER="MEDICARD"

# QA master OTP — 0000 always verifies phone SMS (000000 for email reset).
# Leave empty / unset to turn off. Admin → Settings also has a QA OTP toggle.
# QA_OTP_CODE="0000"

# Expo Push — only needed if Enhanced Push Security is enabled on the project
# EXPO_ACCESS_TOKEN=""

# Mapbox public token (pk.*) — admin overview country map.
# On Render: Environment → Add MAPBOX_PUBLIC_TOKEN → Save (redeploy).
MAPBOX_PUBLIC_TOKEN="pk.your_mapbox_public_token"

# Self-serve in-app purchase. Keep unset/false until StoreKit / Play Billing exist.
# CONSUMER_PURCHASES_ENABLED="false"

# Optional durable uploads (Cloudflare R2 or S3). All four required or disk is used.
# S3_BUCKET=""
# S3_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# Proposed AiInteraction retention (script only; dry-run by default)
# AI_INTERACTION_REDACT_AFTER_DAYS=90
# AI_INTERACTION_DELETE_AFTER_DAYS=365

# Tbilisi finalize cron sets this true. Leave unset on the API web service.
# TBILISI_MOVES_FINALIZE_SCHEDULED="false"

# Production (Render). PORT is injected by the host. Leave EXPO_PUBLIC_API_URL
# unset so the web app uses the same origin (https://medicard.ge).
# EXPO_PUBLIC_API_URL="https://medicard.ge"

