model NutritionSettings {
 id String @id @default("main")
 photoEnabled Boolean @default(true)
 updatedAt DateTime @default(now())
}
model NutritionScanMetric {
 id String @id
 success Boolean
 durationMs Int
 createdAt DateTime @default(now())
