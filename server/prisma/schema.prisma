datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  nutritionMeals NutritionMeal[]
  communityCommentLikes CommunityCommentLike[]
  communityAliases CommunityAlias[]
  communityMember CommunityMember?
  communityPosts CommunityPost[]
  communityComments CommunityComment[]
  communityReactions CommunityReaction[]
  communityBlocks CommunityBlock[] @relation("CommunityBlockOwner")
  communityBlockedBy CommunityBlock[] @relation("CommunityBlockTarget")
  communityReports CommunityReport[]
  communityNotifications CommunityNotification[] @relation("CommunityRecipient")
  communityActions CommunityNotification[] @relation("CommunityActor")
  aiConsent UserAiConsent?
  aiConsentEvents AiConsentEvent[]
  medipulsiPlayer       MedipulsiPlayer?
  medipulsiSessions     MedipulsiSession[]
  medipulsiClaims       MedipulsiClaim[]
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?              @unique
  gender           String? // 'MALE' | 'FEMALE' | 'OTHER'
  birthDate        DateTime?            @db.Date
  /// ACTIVE | BLOCKED
  status           String               @default("ACTIVE")
  packageId        String?
  package          Package?             @relation(fields: [packageId], references: [id])
  /// Start of the current paid billing period (30-day window from purchase/renewal).
  packageStartedAt DateTime?
  packageExpiresAt DateTime?
  adminNote        String?
  /// Daily login bonus — 5 points per calendar day (Asia/Tbilisi).
  points           Int                  @default(0)
  currentStreak    Int                  @default(0)
  longestStreak    Int                  @default(0)
  lastCheckInDate  DateTime?            @db.Date
  /// gemini_flash | ling_free | evidencemd
  aiEngine         String               @default("gemini_flash")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  records          MedicalRecord[]
  checkIns         DailyCheckIn[]
  pointAwards      PointAward[]
  chats            ChatSession[]
  medications      MedicationSchedule[]
  periodUsages     PeriodUsage[]
  pushTokens       PushToken[]
  pushEvents       PushEvent[]
  cycleProfile     CycleProfile?
  cycleLogs        CycleLog[]
  cycleCustomTags  CycleCustomTag[]
  cyclePredictionSnapshots CyclePredictionSnapshot[]
  pregnancyLogs    PregnancyLog[]
  cyclePregnancyEpisodes CyclePregnancyEpisode[]
  cyclePostpartumEpisodes CyclePostpartumEpisode[]
  cyclePostpartumBleedClassifications CyclePostpartumBleedClassification[]
  pregnancyCarePlanItemStates PregnancyCarePlanItemState[]
  cycleSharesOwned    CyclePartnerShare[] @relation("CycleShareOwner")
  cycleSharesAccepted CyclePartnerShare[] @relation("CycleSharePartner")
  aiInteractions   AiInteraction[]
  aiFeedback       AiFeedback[]
  doctorVisits     DoctorVisit[]
  healthProfile    HealthProfile?
  healthMetricDaily HealthMetricDaily[]
  stepLogs         StepLog[]
  notificationDecisions NotificationDecision[]
  appActivities         AppActivity[]
  notificationOutcomes  NotificationOutcome[]
  productEvents         ProductEvent[]
  medicationDoseEvents  MedicationDoseEvent[]
  notificationPermission NotificationPermission?
  userQuests            UserQuest[]
  questCompletions      QuestCompletion[]
  rewardLedger          RewardLedger[]
  questProfile          UserQuestProfile?
  achievements          UserAchievement[]
  hydrationPreference   HydrationPreference?
  hydrationIntakeEvents HydrationIntakeEvent[]
  stepTrackingCapability StepTrackingCapability?
  /// Phase 7 — Medi Rewards Store
  rewardRedemptions     RewardRedemption[]
  rewardEntitlements    UserRewardEntitlement[]
  rewardAuditLogs       RewardRedemptionAudit[]
  /// Phase 9 — Medi Companion
  mediCompanionProfile  MediCompanionProfile?
  mediJourneyUnlocks    MediJourneyUnlock[]
  /// Phase 2 — My Pets identity
  pets                 Pet[]
  petWeightLogs        PetWeightLog[]
  petAllergies         PetAllergy[]
  petConditions        PetCondition[]
  petProducts          PetProduct[]
  petCareSchedules     PetCareSchedule[]
  petCareOccurrences    PetCareOccurrence[]
  petCareEvents        PetCareEvent[]
  petReminderDeliveries PetReminderDelivery[]
  /// Phase 6 — Medi Vet (isolated from human ChatSession)
  petChatSessions      PetChatSession[]
  petChatMessages       PetChatMessage[]

  @@index([status])
  @@index([packageId])
  @@index([createdAt])
  @@index([lastCheckInDate])
  passwordResets    PasswordReset[]
  assistantOperations AssistantOperation[]
}

/// Execution receipt only: no dictated text, health context or audio.
model AssistantOperation {
  id          String   @id @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool        String
  payloadHash String
  status      String
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @db.Timestamptz

  @@index([userId, createdAt])
}

/// One row per user per Tbilisi calendar day. Unique constraint makes the claim idempotent.
model DailyCheckIn {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  pointsAwarded Int      @default(5)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Idempotent bonus ledger — steps goal, future rewards.
model PointAward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  ref       String
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, kind, ref])
  @@index([userId])
}

/// Email OTP for password recovery — 6-digit code, short TTL.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

/// SMS OTP for phone verification — 4-digit code, short TTL.
model PhoneVerification {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String    @default("AUTH") // AUTH | LINK | ADMIN
  userId    String?
  reference String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([userId])
  @@index([expiresAt])
  @@index([reference])
}

/// Outbound SMS audit log (SMSOffice.ge and admin sends).
model SmsLog {
  id           String   @id @default(uuid())
  destination  String
  content      String
  sender       String   @default("MEDICARD")
  purpose      String   @default("OTP") // OTP | ADMIN | MARKETING | TEST
  reference    String?
  status       String   @default("QUEUED") // QUEUED | SENT | FAILED
  providerCode Int?
  providerMsg  String?
  userId       String?
  adminId      String?
  createdAt    DateTime @default(now())

  @@index([destination])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
}

/// Comprehensive health assessment data collected after registration.
model HealthProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm               Float?
  weightKg               Float?
  bloodType              String?
  activityLevel          String?
  exerciseFrequency      String?
  sleepQuality           String?
  sleepHours             Float?
  stressLevel            String?
  smokingStatus          String?
  alcoholUse             String?
  dietType               String?
  waterIntakeL           Float?
  restingHeartRate       Int?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  /// string[] — e.g. diabetes, hypertension
  chronicConditions      Json      @default("[]")
  /// string[]
  allergies              Json      @default("[]")
  /// string[]
  medications            Json      @default("[]")
  /// string[]
  familyHistory          Json      @default("[]")
  /// string[]
  healthGoals            Json      @default("[]")
  /// Extra step answers keyed by assessment step id
  extraAnswers           Json      @default("{}")
  currentStepIndex       Int       @default(0)
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// Idempotent in-app hydration intake. Daily total is the sum of these events.
model HydrationIntakeEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientEventId String
  /// YYYY-MM-DD
  date          String
  deltaMl       Int
  createdAt     DateTime @default(now())

  @@unique([userId, clientEventId])
  @@index([userId, date])
}

/// Privacy-safe step-tracking capability. No device hardware identifiers.
model StepTrackingCapability {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AVAILABLE | UNAVAILABLE | PERMISSION_DENIED | NOT_CONFIGURED | UNKNOWN
  status    String
  /// APPLE_HEALTH | HEALTH_CONNECT | OTHER | UNKNOWN
  source    String   @default("UNKNOWN")
  updatedAt DateTime @updatedAt
}

/// User-chosen hydration goal for the app. Not a medical prescription.
model HydrationPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalMl    Int
  updatedAt DateTime @updatedAt
}

/// Daily health aggregates synced from device (Apple Health / Health Connect).
model HealthMetricDaily {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD calendar day (user-local when synced from mobile)
  date                   String
  steps                  Int?
  weightKg               Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Float?
  sleepHours             Float?
  nutritionKcal          Float?
  hydrationMl            Float?
  activeMinutes          Int?
  distanceKm             Float?
  /// device | manual | merged
  source                 String   @default("device")
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Individual step samples synced from device health apps.
model StepLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  stepCount  Int
  source     String   @default("device")
  createdAt  DateTime @default(now())

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

/// Women's health — one profile per user (FEMALE-gated in API)
model CycleProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TRACK_PERIOD | TRY_TO_CONCEIVE | PREGNANCY | PERIMENOPAUSE | POSTPARTUM
  mode             String    @default("TRACK_PERIOD")
  avgCycleLength   Int       @default(28)
  avgPeriodLength  Int       @default(5)
  lastPeriodStart  DateTime? @db.Date
  isIrregular      Boolean   @default(false)
  dueDate          DateTime? @db.Date
  /// Local privacy — client enforces; stored hash optional
  privacyEnabled   Boolean   @default(false)
  partnerShareCode String?   @unique
  /// Cached Flo-style AI recommendations (JSON)
  aiInsights       Json?
  aiInsightsAt     DateTime?
  /// e.g. ["pcos","endometriosis","perimenopause"]
  conditions       Json      @default("[]")
  /// Optional mirror of mobile reminder prefs for cross-device sync
  reminderPrefs    Json?
  /// Current method only. null = never asked; NONE = explicit no method.
  contraceptionMethod     String?
  contraceptionStartedAt  DateTime? @db.Date
  /// Phase 42. null = ordinary TRACK. POSTPARTUM_RETURN = explicit leave from postpartum.
  /// Never backfilled. Forecast readiness is derived from classified history, not stored here.
  forecastGateKind        String?
  /// Ended CyclePostpartumEpisode that scopes post-postpartum forecast evidence.
  forecastGateEpisodeId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CycleLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD (Asia/Tbilisi calendar day)
  date            String
  /// none | spotting | light | medium | heavy
  flow            String?
  /// string[] symptom keys
  symptoms        Json     @default("[]")
  /// string[] mood keys
  moods           Json     @default("[]")
  sexualActivity  Boolean?
  libido          Int? // 1-5
  bbt             Float?
  /// dry | sticky | creamy | watery | eggwhite
  cervicalMucus   String?
  /// negative | positive | unclear — user-logged OPK result, not confirmed ovulation
  ovulationTest   String?
  /// negative | positive | unclear — user-logged pregnancy-test result, not a diagnosis
  pregnancyTest   String?
  notes           String?
  /// [{ type, severity }] — user-logged. Does not change predictions.
  painEntries     Json     @default("[]")
  /// poor | okay | good
  sleepQuality    String?
  /// low | medium | high
  stressLevel     String?
  /// none | light | moderate | intense
  exerciseLevel   String?
  /// none | low | moderate | high
  caffeine        String?
  /// none | light | moderate | heavy
  alcohol         String?
  /// CycleCustomTag ids for this calendar day
  customTagIds    Json     @default("[]")
  /// Registry-backed extras that are not dedicated columns (e.g. energy).
  observations    Json     @default("{}")
  observationSchemaVersion Int @default(1)
  /// Explicit absence coverage for assessment-eligible keys. PRESENT is derived from symptoms[].
  /// Missing key = UNKNOWN. Never backfilled. Additive Phase 28.
  observationAssessments Json @default("{}")
  /// null | POSTPARTUM. Engine excludes POSTPARTUM. Never backfilled. Not a diagnosis.
  trackingContext String?
  /// Active/ended postpartum episode this write belonged to. Null for historical logs.
  postpartumEpisodeId String?
  postpartumEpisode CyclePostpartumEpisode? @relation(fields: [postpartumEpisodeId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
  @@index([userId, trackingContext])
  @@index([postpartumEpisodeId])
}

/// User-owned Cycle labels. Archive instead of hard-delete.
model CycleCustomTag {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  @@index([userId, archivedAt])
  @@index([userId, nameNormalized])
}

/// Phase 8: what MediCard predicted at the time. Immutable observation. Not engine output.
model CyclePredictionSnapshot {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NEXT_PERIOD_START
  type            String   @default("NEXT_PERIOD_START")
  predictedDate   String
  snapshotDate    String
  snapshotAt      DateTime @default(now())
  /// Derived LMP at observation — episode identity (not the moving predictedDate).
  cycleAnchorDate String
  confidence      String
  engineVersion   Int
  validGapCount   Int      @default(0)
  isIrregular     Boolean  @default(false)
  /// inferred | stored | default
  source          String   @default("stored")
  createdAt       DateTime @default(now())

  @@unique([userId, type, cycleAnchorDate, predictedDate, confidence, engineVersion], map: "CyclePredictionSnapshot_identity")
  @@index([userId, cycleAnchorDate])
  @@index([userId, snapshotDate])
  @@index([userId, type, createdAt])
}

/// One active invite per owner in product UI. Token hash is looked up; plaintext is owner-only.
model CyclePartnerShare {
  id            String    @id @default(uuid())
  ownerUserId   String
  owner         User      @relation("CycleShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  partnerUserId String?
  partner       User?     @relation("CycleSharePartner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  /// SHA-256 hex of the invite token
  tokenHash     String    @unique
  /// period | cyclePhase | fertileWindow | symptoms
  permissions   Json
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([ownerUserId])
  @@index([partnerUserId])
}

model PregnancyLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  currentWeek Int?
  weightKg    Float?
  symptoms    Json     @default("[]")
  kickCount   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Phase 18 — one pregnancy episode. Mode=PREGNANCY requires exactly one ACTIVE row.
/// History is retained (ENDED). Re-entry creates a new episode. No outcome enum.
model CyclePregnancyEpisode {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Civil YYYY-MM-DD. Preferred source: confirmed last menstrual period.
  referenceDate String
  /// LMP | USER_SELECTED
  referenceType String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  /// ACTIVE | ENDED
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  carePlanStates PregnancyCarePlanItemState[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

/// Owner-selected postpartum tracking interval. Not a pregnancy outcome.
/// One ACTIVE episode per user (SQL partial unique). Re-entry creates a new row.
model CyclePostpartumEpisode {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Owner-entered civil YYYY-MM-DD. Optional. Not a birth date. Never derived.
  referenceDate String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  /// ACTIVE | ENDED
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  logs          CycleLog[]
  bleedClassifications CyclePostpartumBleedClassification[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

/// Phase 41 — owner-only explicit classification of a postpartum bleed episode.
/// V1 classification is MENSTRUAL_PERIOD only. Absence = UNKNOWN. Not a diagnosis.
/// Identity is the engine bleed-run start (inferCycleStats / canContinuePeriod).
model CyclePostpartumBleedClassification {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postpartumEpisodeId String
  postpartumEpisode    CyclePostpartumEpisode @relation(fields: [postpartumEpisodeId], references: [id], onDelete: Cascade)
  /// First PERIOD_FLOW day of the grouped bleed run.
  bleedStart          String
  bleedEnd            String
  /// MENSTRUAL_PERIOD
  classification      String   @default("MENSTRUAL_PERIOD")
  /// OWNER
  source              String   @default("OWNER")
  classifiedAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, postpartumEpisodeId, bleedStart])
  @@index([userId, postpartumEpisodeId])
}

/// Owner-only prenatal care planner overrides. Catalog items stay in versioned code.
model PregnancyCarePlanItemState {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pregnancyEpisodeId   String
  episode              CyclePregnancyEpisode @relation(fields: [pregnancyEpisodeId], references: [id], onDelete: Cascade)
  careItemId           String
  /// PLANNED | COMPLETED | DISMISSED | NOT_APPLICABLE
  status               String
  plannedDate          String?
  /// Optional local wall-clock HH:mm. Null means date-only. Never stored without plannedDate.
  plannedTime          String?
  /// Optional owner-entered visit place text. Null without plannedDate. Never geocoded.
  plannedPlace         String?
  completedDate        String?
  note                 String?
  catalogVersion       String
  /// Owner opt-in. Never auto-enabled by plannedDate, plannedTime, or catalog window.
  reminderEnabled      Boolean  @default(false)
  /// Civil DAYS for DATE_BASED only. 0 = same civil day, 1 = one day before, 3 = three days before.
  reminderOffset       Int      @default(1)
  /// DATE_BASED (default / legacy null) | EXACT_TIME. Null means DATE_BASED.
  reminderMode         String?
  /// Minutes before plannedTime for EXACT_TIME only: 0, 30, 60, 120. Never reinterpret reminderOffset.
  exactReminderOffsetMinutes Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([pregnancyEpisodeId, careItemId])
  @@index([userId])
  @@index([pregnancyEpisodeId])
}

model Package {
  id            String   @id @default(uuid())
  /// FREE | STANDARD | ULTIMATE
  code          String   @unique
  nameKa        String
  nameEn        String
  descriptionKa String
  /// Monthly equivalent for marketing / admin (-1 = unlimited). Metering uses dailyAiLimit.
  monthlyAiLimit Int      @default(90)
  /// Consume cap per day. Unused credits reset at Tbilisi midnight; hitting the cap starts a 24h lock.
  dailyAiLimit  Int       @default(3)
  priceGel      Float     @default(0)
  /// JSON feature flags / module access
  features      Json
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  /// Phase 8 — JSON string[] of capabilities. null = full legacy access.
  capabilities  Json?
  pushCampaigns PushCampaign[]
  aiEvalRuns    AiEvalRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Singleton row id = "default"
model AppSettings {
  id                 String   @id @default("default")
  /// When true, mobile/API refuse non-admin traffic with maintenance message
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("აპლიკაცია დროებით განახლების რეჟიმშია. გთხოვთ, სცადოთ მოგვიანებით.")
  /// Soft gate: clients below this see an update prompt
  minAppVersion      String   @default("1.0.0")
  /// Hard gate: clients below minAppVersion cannot use the API
  forceUpdate        Boolean  @default(false)
  allowRegistrations Boolean  @default(true)
  supportEmail       String   @default("support@medicard.ge")
  /// When true, phone OTP 0000 and email reset 000000 always verify. Turn off after QA.
  qaOtpEnabled       Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model PeriodUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Billing period key — rolling daily (roll:daily), calendar month (cal:YYYY-MM), or subscription (sub:start:end).
  periodKey String
  count     Int      @default(0)
  /// In-flight AI reservations. Shared by human Medi and Medi Vet. Not a Prisma-only field: SQL and runtime ALTER also add it.
  reserved  Int      @default(0)
  /// When the current in-flight reservation was taken. Stale reserved > 20m is released.
  reservedAt DateTime?
  /// Unlock instant. Under the cap this is the next Tbilisi midnight; after a 0/N hit it is now + 24h.
  resetAt   DateTime?
  /// Quiet-hours-aware ping after a refill. Cleared once the user is notified.
  notifyAt  DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, periodKey])
  @@index([userId])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // ios | android | web
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, active])
}

/// Audit log for every AI call — foundation for quality engine and admin review.
model AiInteraction {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DOCTOR | CONSILIUM | LAB | IMAGING | SKIN | SKINCARE | MEDICATION | CYCLE_WELLNESS | SYMPTOM_CHECKER
  mode            String
  status          String         @default("OK") // OK | ERROR
  errorMessage    String?
  promptVersion   String         @default("1.0.0")
  chatSessionId   String?
  medicalRecordId String?
  userPrompt      String?
  assistantReply  String?
  visionProvider  String?
  visionModel     String?
  reasoningModel  String?
  latencyMs       Int?
  tokenUsage      Json?
  createdAt       DateTime       @default(now())
  feedback        AiFeedback[]
  evalResults     AiEvalResult[]

  @@index([userId, createdAt])
  @@index([mode, createdAt])
  @@index([status, createdAt])
}

model AiFeedback {
  id            String        @id @default(uuid())
  interactionId String
  interaction   AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 = helpful, -1 = not helpful
  rating        Int
  comment       String?
  createdAt     DateTime      @default(now())

  @@unique([interactionId, userId])
  @@index([rating, createdAt])
}

model AiEvalRun {
  id            String         @id @default(uuid())
  status        String         @default("RUNNING") // RUNNING | DONE | FAILED
  sampleSize    Int            @default(0)
  avgScore      Float?
  lowScoreCount Int            @default(0)
  summary       String?
  triggeredById String?
  triggeredBy   Admin?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?
  results       AiEvalResult[]

  @@index([createdAt])
}

model AiEvalResult {
  id            String         @id @default(uuid())
  runId         String
  run           AiEvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  interactionId String?
  interaction   AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  mode          String
  score         Int
  passed        Boolean
  rubric        Json
  notes         String?
  sourceType    String         @default("interaction")
  sourceId      String?
  createdAt     DateTime       @default(now())

  @@index([runId])
  @@index([score])
}

/// Admin-editable Medi copy. Missing row = code default.
model PushTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

/// Local / QA / device-received notifications. Broadcasts stay on PushCampaign.
model PushEvent {
  id        String   @id @default(uuid())
  source    String
  key       String
  title     String
  body      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([key])
}

model PushCampaign {
  id          String    @id @default(uuid())
  title       String
  body        String
  data        Json?
  /// ALL | FREE | STANDARD | ULTIMATE | ACTIVE
  segment     String    @default("ALL")
  status      String    @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  targetCount Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String?
  createdBy   Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model DailyUsage {
  id        String   @id @default(uuid())
  userId    String
  date      String // Format: YYYY-MM-DD — legacy, superseded by PeriodUsage
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model MedicalRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // 'LAB', 'XRAY', 'CT_MRI', 'SKIN', 'SKINCARE', 'PRESCRIPTION', 'SYMPTOM'
  imageUrl   String?
  aiAnalysis String // JSON or Markdown string in Georgian
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("ახალი საუბარი")
  mode      String   @default("DOCTOR") // 'DOCTOR' | 'CONSILIUM'
  messages  Json // Array of message objects { role, content, timestamp }
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model MedicationSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medName   String
  dosage    String
  frequency String // e.g., '09:00, 15:00, 21:00'
  notes     String?
  active    Boolean  @default(true)
  /// pill shape/color, days of week, refill settings, form type, dates, etc.
  config    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, active])
}

/// Scheduled doctor visit with optional location and local notification rules.
model DoctorVisit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GP | DENTIST | CARDIO | GYN | NEURO | ORTHO | THERAPIST | OPHTHALMO | DERM | PED | OTHER
  doctorType      String
  doctorFirstName String?
  doctorLastName  String?
  /// YYYY-MM-DD local calendar day
  visitDate       String
  /// HH:mm 24h
  visitTime       String
  address         String?
  addressLabel    String?
  lat             Float?
  lng             Float?
  notes           String?
  /// { enabled, offsetsMinutes: number[], repeatCount: number }
  reminderConfig  Json     @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, visitDate])
  @@index([userId, active])
}

/// Pharmacy chain (Pharmadepot, Aversi, PSP)
model PharmacySource {
  id        String          @id // PHARMADEPOT | AVERSI | PSP
  nameKa    String
  logoUrl   String?
  baseUrl   String
  offers    PharmacyOffer[]
  bestFor   CatalogProduct[] @relation("BestSource")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// Unified medication category tree
model DrugCategory {
  id          String              @id @default(uuid())
  slug        String              @unique
  nameKa      String
  iconUrl     String?
  parentId    String?
  parent      DrugCategory?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    DrugCategory[]      @relation("CategoryTree")
  sortOrder   Int                 @default(0)
  products    CatalogProduct[]
  sourceMaps  SourceCategoryMap[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([parentId, sortOrder])
}

/// Maps external category ids to unified DrugCategory
model SourceCategoryMap {
  id             String       @id @default(uuid())
  source         String // PHARMADEPOT | AVERSI | PSP
  sourceCategory String
  categoryId     String
  category       DrugCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([source, sourceCategory])
  @@index([categoryId])
}

/// Canonical product matched across pharmacies
model CatalogProduct {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  normalizedKey  String
  imageUrl       String?
  manufacturer   String?
  country        String?
  form           String?
  strength       String?
  packSize       String?
  description    String?
  categoryId     String?
  category       DrugCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bestPriceGel   Float?
  bestSourceId   String?
  bestSource     PharmacySource? @relation("BestSource", fields: [bestSourceId], references: [id], onDelete: SetNull)
  offerCount     Int             @default(0)
  lastSyncedAt   DateTime?
  offers         PharmacyOffer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([normalizedKey])
  @@index([categoryId])
  @@index([bestPriceGel])
  @@index([name])
}

/// Per-pharmacy listing for a catalog product
model PharmacyOffer {
  id               String         @id @default(uuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  sourceId         String
  source           PharmacySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceProductId  String
  sourceUrl        String
  rawName          String
  priceGel         Float
  oldPriceGel      Float?
  discountPercent  Float?
  inStock          Boolean        @default(true)
  imageUrl         String?
  syncedAt         DateTime       @default(now())

  @@unique([sourceId, sourceProductId])
  @@unique([catalogProductId, sourceId])
  @@index([catalogProductId, priceGel])
  @@index([syncedAt])
}

/// Sync job audit log
model SyncRun {
  id           String    @id @default(uuid())
  source       String // PHARMADEPOT | AVERSI | PSP | ALL
  status       String    @default("RUNNING") // RUNNING | DONE | FAILED
  itemsFetched Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, startedAt])
}

/// One authenticated app-open per Tbilisi day. DAU/WAU/MAU source. Not a login bonus.
model AppActivity {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  firstAt      DateTime
  lastAt       DateTime
  platform     String?
  appVersion   String?
  activityType String   @default("open")

  @@unique([userId, date])
  @@index([date])
  @@index([lastAt])
  @@index([appVersion])
}

/// Sanitized Brain outcomes. No titles, bodies, health values, or chat.
model NotificationOutcome {
  id         String   @id @default(uuid())
  decisionId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome    String
  actionKey  String   @default("")
  occurredAt DateTime
  appVersion String?
  platform   String?
  implied    Boolean  @default(false)
  syncedAt   DateTime @default(now())

  @@unique([decisionId, outcome, actionKey])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([outcome, occurredAt])
}

model ProductEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  category   String?
  entityId   String?
  source     String?
  occurredAt DateTime
  appVersion String?
  platform   String?

  @@unique([userId, kind, entityId])
  @@index([kind, occurredAt])
}

model MedicationDoseEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String
  date         String
  time         String
  status       String
  source       String
  occurredAt   DateTime

  @@unique([userId, medicationId, date, time])
  @@index([date])
}

model NotificationPermission {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  platform  String?
  updatedAt DateTime
}

/// Sanitized Notification Brain decisions synced from devices. No health values, no chat text.
model NotificationDecision {
  id                String    @id
  decisionId        String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate         String
  family            String
  score             Int       @default(0)
  /// SEND | BLOCKED | CANCELLED | REVALIDATED
  result            String
  reason            String?
  templateKey       String?
  route             String?
  selectedFrequency String?
  baseDailyCap      Int?
  adaptiveDailyCap  Int?
  ewma              Float?
  createdAt         DateTime
  scheduledAt       DateTime?
  revalidatedAt     DateTime?
  syncedAt          DateTime  @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([family, createdAt])
  @@index([userId, createdAt])
}

/// Reusable Medi Quest definition. Config must never contain health notes or PII.
model QuestTemplate {
  id             String    @id @default(uuid())
  key            String    @unique
  /// MOVEMENT | HYDRATION | MEDI | WEATHER | WELLNESS
  category       String
  /// DAILY | WEEKLY | EVENT
  cadence        String
  titleKey       String
  descriptionKey String
  /// STEPS | HYDRATION_GOAL_PERCENT | MEDI_DAILY_USE | COUNT
  progressType   String
  defaultTarget  Int
  rewardCoins    Int       @default(0)
  rewardXp       Int       @default(0)
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  startAt        DateTime?
  endAt          DateTime?
  /// Non-sensitive quest configuration only (metric key, window). Never health notes.
  config         Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignments    UserQuest[]

  @@index([isActive, cadence, priority])
}

/// Concrete quest assignment for one user and one local period.
model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestTemplate @relation(fields: [templateId], references: [id])
  /// Local calendar day `YYYY-MM-DD` or ISO week `YYYY-Www`.
  periodKey   String
  target      Int
  progress    Int       @default(0)
  /// ACTIVE | COMPLETED | CLAIMED | EXPIRED | CANCELLED
  status      String    @default("ACTIVE")
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime
  /// Safe operational values only — never health notes, med names, symptoms, chat.
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completions QuestCompletion[]

  @@unique([userId, templateId, periodKey])
  @@index([userId, status])
  @@index([userId, periodKey])
  @@index([expiresAt])
}

/// Immutable quest completion. Unique on userQuestId — never complete twice.
model QuestCompletion {
  id                   String   @id @default(uuid())
  userQuestId          String   @unique
  userQuest            UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt          DateTime @default(now())
  progressAtCompletion Int
  /// sync | claim | system
  source               String
  createdAt            DateTime @default(now())

  @@index([userId, completedAt])
}

/// Immutable reward ledger. Authoritative for XP and coins. Unique per payee/currency/source.
model RewardLedger {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// XP | COIN
  currency        String
  amount          Int
  /// EARN | ADJUST
  transactionType String
  /// QUEST | ACHIEVEMENT | SYSTEM
  sourceType      String
  sourceId        String
  createdAt       DateTime @default(now())
  metadata        Json?

  @@unique([userId, currency, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([userId, currency])
}

/// Cached quest profile. Ledger remains authoritative for XP and coins.
model UserQuestProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel        Int      @default(1)
  totalXp             Int      @default(0)
  cachedCoinBalance   Int      @default(0)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  lastActiveQuestDate String?
  /// IANA timezone, e.g. Europe/Brussels. Legacy fallback is Asia/Tbilisi.
  timezone            String?
  lastDailyAssignPeriodKey String?
  lastDailyAssignAt   DateTime?
  updatedAt           DateTime @updatedAt
}

/// Phase 4 — long-term achievement definition. Config-free, no PII, no health data.
model AchievementDefinition {
  id             String   @id @default(uuid())
  key            String   @unique
  /// FIRST | QUESTS | STREAK | MOVE | HYDRATE | MEDI | WEEKLY | LEVEL | COINS | COMEBACK | TIME_OF_DAY
  family         String
  /// PROGRESSION | STREAK | MOVEMENT | HYDRATION | MEDI | WEEKLY | LEVEL | COINS | SPECIAL
  category       String
  /// COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  rarity         String
  threshold      Int
  rewardCoins    Int      @default(0)
  rewardXp       Int      @default(0)
  /// Secret achievements are masked in the API until unlocked.
  isSecret       Boolean  @default(false)
  titleKey       String
  descriptionKey String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  unlocks        UserAchievement[]

  @@index([isActive, sortOrder])
  @@index([family])
}

/// Immutable achievement unlock. Never deleted or downgraded once created.
model UserAchievement {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId    String
  achievement      AchievementDefinition @relation(fields: [achievementId], references: [id])
  unlockedAt       DateTime @default(now())
  claimedAt        DateTime?
  /// Counter value observed at unlock time (server-computed).
  progressAtUnlock Int      @default(0)
  /// UNLOCKED | CLAIMED
  status           String   @default("UNLOCKED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, achievementId])
  @@index([userId, status])
  @@index([userId, unlockedAt])
}

/// Admin actions — template edits, settings, user status. Never store secrets.
model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String?
  adminEmail    String
  action        String
  targetType    String
  targetId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// Phase 7/8 — commercial partner for loyalty vouchers (not Pharmacy CRM / not health).
model RewardPartner {
  id                 String   @id @default(uuid())
  key                String   @unique
  displayName        String
  legalName          String?
  /// PHARMACY | LAB | FITNESS | WELLNESS | FOOD | RETAIL | INSURANCE | CLINIC | OTHER
  category           String?
  logoAssetKey       String?
  website            String?
  contactName        String?
  contactEmail       String?
  countryCode        String?
  notes              String?
  lowStockThreshold  Int?
  /// DRAFT | ACTIVE | PAUSED | ARCHIVED (legacy INACTIVE treated as not ACTIVE)
  status             String   @default("DRAFT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  rewards            RewardDefinition[]
  campaigns          RewardCampaign[]
}

/// Phase 7 — Medi Coins Rewards Store catalog (loyalty points only).
model RewardDefinition {
  id                    String   @id @default(uuid())
  key                   String   @unique
  /// DIGITAL_PERK | COUPON_CODE | PARTNER_VOUCHER | PREMIUM_ACCESS
  type                  String
  /// DRAFT | ACTIVE | PAUSED | ENDED | ARCHIVED
  status                String   @default("DRAFT")
  titleKey              String
  descriptionKey        String
  termsKey              String?
  imageKey              String?
  coinCost              Int
  partnerId             String?
  partner               RewardPartner? @relation(fields: [partnerId], references: [id])
  /// UNLIMITED | FINITE | CODE_POOL
  inventoryMode         String   @default("UNLIMITED")
  inventoryQuantity     Int?
  perUserLimit          Int?
  /// NONE | DAILY | WEEKLY | MONTHLY | LIFETIME | ROLLING_DAYS
  periodLimitType       String?
  periodLimitCount      Int?
  /// When periodLimitType = ROLLING_DAYS (e.g. 14-day cooldown).
  periodWindowDays      Int?
  startsAt              DateTime?
  endsAt                DateTime?
  redemptionExpiryDays  Int?
  /// Entitlement key issued on DIGITAL_PERK / PREMIUM_ACCESS redeem (e.g. quest.theme.premium).
  entitlementKey        String?
  entitlementDurationDays Int?
  sortOrder             Int      @default(0)
  featured              Boolean  @default(false)
  lowStockThreshold     Int?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  redemptions           RewardRedemption[]
  codes                 RewardCode[]
  inventoryAdjustments  RewardInventoryAdjustment[]
  campaigns             RewardCampaign[]

  @@index([status, sortOrder])
  @@index([type, status])
  @@index([featured, status])
}

/// Phase 8 — partner campaign wrapping a RewardDefinition (commercial ops).
model RewardCampaign {
  id                    String   @id @default(uuid())
  key                   String   @unique
  partnerId             String
  partner               RewardPartner @relation(fields: [partnerId], references: [id])
  rewardDefinitionId    String
  reward                RewardDefinition @relation(fields: [rewardDefinitionId], references: [id])
  name                  String
  /// DRAFT | SCHEDULED | ACTIVE | PAUSED | ENDED | ARCHIVED
  status                String   @default("DRAFT")
  startsAt              DateTime?
  endsAt                DateTime?
  /// SPONSORED_FIXED | PER_REDEMPTION | PER_USED | AFFILIATE | INTERNAL
  fundingModel          String?
  budgetType            String?
  budgetValue           Int?
  maxRedemptions        Int?
  perUserLimit          Int?
  periodLimitType       String?
  periodLimitCount      Int?
  periodWindowDays      Int?
  marketCountryCode     String?
  commercialValueMinor  Int?
  commercialCurrency    String?
  internalCostMinor     Int?
  lowStockThreshold     Int?
  sortOrder             Int      @default(0)
  createdByAdminId      String?
  updatedByAdminId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  redemptions           RewardRedemption[]

  @@index([partnerId, status])
  @@index([rewardDefinitionId, status])
  @@index([status, startsAt, endsAt])
}

/// Phase 7 — one redemption = one spend. coinCost is snapshotted.
model RewardRedemption {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId           String
  reward             RewardDefinition @relation(fields: [rewardId], references: [id])
  campaignId         String?
  campaign           RewardCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  partnerIdSnapshot  String?
  commercialValueMinorSnapshot Int?
  commercialCurrencySnapshot   String?
  /// PENDING | ISSUED | USED | EXPIRED | CANCELLED
  status             String   @default("ISSUED")
  coinCost           Int
  ledgerEntryId      String?
  codeId             String?  @unique
  code               RewardCode? @relation(fields: [codeId], references: [id])
  idempotencyKey     String?
  redeemedAt         DateTime @default(now())
  expiresAt          DateTime?
  usedAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  entitlements       UserRewardEntitlement[]
  auditLogs          RewardRedemptionAudit[]

  @@unique([userId, idempotencyKey])
  @@index([userId, redeemedAt])
  @@index([userId, status])
  @@index([rewardId, status])
  @@index([campaignId])
  @@index([partnerIdSnapshot])
  @@index([redeemedAt])
  @@index([status, redeemedAt])
}

/// Phase 7 — partner / coupon codes. Never allocate the same code twice.
model RewardCode {
  id                     String   @id @default(uuid())
  rewardId               String
  reward                 RewardDefinition @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  code                   String
  /// AVAILABLE | RESERVED | USED | EXPIRED | DISABLED
  status                 String   @default("AVAILABLE")
  reservedByRedemptionId String?
  reservedAt             DateTime?
  usedAt                 DateTime?
  expiresAt              DateTime?
  createdAt              DateTime @default(now())
  redemption             RewardRedemption?

  @@unique([rewardId, code])
  @@index([rewardId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

/// Phase 7 — finite inventory audit trail (never silent stock mutation).
model RewardInventoryAdjustment {
  id        String   @id @default(uuid())
  rewardId  String
  reward    RewardDefinition @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  actorType String   @default("SYSTEM")
  actorId   String?
  createdAt DateTime @default(now())

  @@index([rewardId, createdAt])
}

/// Phase 7 — first-party digital perk entitlements (cosmetics / premium).
model UserRewardEntitlement {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardRedemptionId String
  redemption         RewardRedemption @relation(fields: [rewardRedemptionId], references: [id], onDelete: Cascade)
  entitlementKey     String
  startsAt           DateTime
  endsAt             DateTime
  /// ACTIVE | EXPIRED | REVOKED
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())

  @@index([userId, entitlementKey, status])
  @@index([userId, endsAt])
  @@index([rewardRedemptionId])
}

/// Phase 7 — immutable redemption status transitions (no coupon plaintext).
model RewardRedemptionAudit {
  id           String   @id @default(uuid())
  redemptionId String
  redemption   RewardRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId     String
  coinCost     Int
  fromStatus   String?
  toStatus     String
  note         String?
  createdAt    DateTime @default(now())

  @@index([redemptionId, createdAt])
  @@index([userId, createdAt])
}

/// Phase 9 — Medi Companion cosmetic loadout (derived progress is not stored).
/// Phase 9 companion row. Extra columns below are unused leftovers with DB defaults.
model MediCompanionProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Slot map: accent / accessory / background / decoration → cosmetic catalog keys
  selectedCosmetics       Json     @default("{}")
  selectedEnvironmentKey  String   @default("env.day")
  /// Phase 40 — private display name. Null means default "Medi".
  displayName             String?
  /// Unused companion stage key (DB default).
  worldStageKey           String   @default("spark")
  bondPoints              Int      @default(0)
  lastWorldVisitPeriodKey String?
  lastCareMomentPeriodKey String?
  lastCareMomentKey       String?
  lastSeenAt              DateTime?
  equippedAuraKey         String   @default("aura_teal_origin")
  equippedTrailKey        String?
  equippedCharmKey        String?
  equippedAccentKey       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Phase 9 — idempotent Journey milestone unlock rows (progress still derived from QuestCompletion).
model MediJourneyUnlock {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneKey String
  unlockedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, milestoneKey])
  @@index([userId, unlockedAt])
}

/// Phase 2 — My Pets identity. Not HealthProfile. Care/chat tables come in later phases.
model Pet {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  speciesId           String
  /// Catalog breed id, or sentinel mixed | unknown | custom
  breedId             String
  customBreed         String?
  /// MALE | FEMALE | UNKNOWN
  sex                 String    @default("UNKNOWN")
  /// null = unknown; never default false
  neutered            Boolean?
  /// EXACT | APPROXIMATE | UNKNOWN
  ageKind             String
  birthDate           DateTime? @db.Date
  approxAgeYears      Int?
  approxAgeMonths     Int?
  /// Civil YYYY-MM-DD when the approximate age was stated
  approxAgeRecordedOn String?
  /// Storage key /uploads/<uuid>.ext — not a public URL
  photoUrl            String?
  vetClinicName       String?
  vetName             String?
  vetPhone            String?
  vetAddress          String?
  vetNotes            String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  weightLogs          PetWeightLog[]
  allergies           PetAllergy[]
  conditions          PetCondition[]
  products            PetProduct[]
  careSchedules       PetCareSchedule[]
  careOccurrences     PetCareOccurrence[]
  careEvents          PetCareEvent[]
  reminderDeliveries  PetReminderDelivery[]
  chatSessions         PetChatSession[]
  chatMessages         PetChatMessage[]

  @@index([userId, archivedAt])
  @@index([userId, createdAt])
}

/// Phase 3 — pet weight history. Never HealthMetricDaily / medicard.weight.logs.v1.
model PetWeightLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// Civil YYYY-MM-DD
  recordedOn      String
  /// Normalized kilograms. Decimal so small animals round-trip.
  weightKg        Decimal  @db.Decimal(10, 5)
  /// Value the owner typed (for honest display).
  inputValue      Decimal  @db.Decimal(12, 4)
  /// kg | g | lb
  inputUnit       String
  note            String?
  /// Optional idempotency key for create retries. Multiple NULLs allowed.
  clientRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petId, clientRequestId])
  @@index([petId, recordedOn, createdAt])
  @@index([userId, petId])
}

/// Phase 3 — owner-recorded pet allergy. Not human allergyCatalog.
model PetAllergy {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  name            String
  /// medication | food | environmental | other | unknown
  category        String    @default("unknown")
  reaction        String?
  /// suspected | veterinarian_confirmed
  reportedStatus  String
  /// Optional civil YYYY-MM-DD when observed / recorded
  notedOn         String?
  notes           String?
  clientRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petId, clientRequestId])
  @@index([userId, petId])
}

/// Phase 3 — owner-recorded pet condition. Not a diagnosis engine.
model PetCondition {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  name            String
  /// active | resolved | unknown
  status          String
  /// owner_reported | veterinarian_confirmed
  reportedBasis   String
  /// Optional civil YYYY-MM-DD — onset or diagnosis if the owner knows it
  onsetOn         String?
  /// Optional civil YYYY-MM-DD — only when status is resolved
  resolvedOn      String?
  notes           String?
  clientRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petId, clientRequestId])
  @@index([petId, status])
  @@index([userId, petId])
}

/// Phase 4 — owner-held care product. Not a pharmacy catalog. expiresOn never computes next due.
model PetProduct {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// VACCINATION | FLEA_TICK | DEWORMING | MEDICATION | OTHER
  kind            String
  name            String
  formulation     String?
  batchId         String?
  notes           String?
  /// Civil YYYY-MM-DD — expiry only
  expiresOn       String?
  archivedAt      DateTime?
  clientRequestId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  schedules       PetCareSchedule[]
  events          PetCareEvent[]

  @@unique([petId, clientRequestId])
  @@index([userId, petId, archivedAt])
}

/// Phase 4 — planned care. Recurrence intent is stored; nextDueOn is derived for listing / Phase 5.
model PetCareSchedule {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId               String
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  productId           String?
  product             PetProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind                String
  title               String
  dose                String?
  doseUnit            String?
  route               String?
  /// Civil first due / start
  startOn             String
  dueTime             String?
  /// Explicit local times for DAILY_COURSE, e.g. ["08:00","20:00"]
  times               Json?
  /// ONCE | EVERY_N_DAYS | EVERY_N_WEEKS | EVERY_N_MONTHS | DAILY_COURSE
  recurrenceKind      String
  intervalCount       Int?
  /// NONE | FIXED_CALENDAR | FROM_ADMINISTRATION
  recurrenceBasis     String
  /// VETERINARIAN | PRODUCT_INSTRUCTIONS | USER_ENTERED
  source              String
  sourceNote          String?
  courseEndsOn        String?
  occurrenceLimit     Int?
  /// Original day-of-month for month-end anchoring
  anchorDay           Int?
  /// ACTIVE | COMPLETED | CANCELLED
  status              String    @default("ACTIVE")
  revision            Int      @default(1)
  nextDueOn           String?
  nextDueTime         String?
  nextSequence        Int?
  reminderEnabled     Boolean   @default(false)
  reminderOffsetsDays Json      @default("[0]")
  /// DATE_BASED | EXACT_TIME
  timeMode            String    @default("DATE_BASED")
  timezone            String?
  clientRequestId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  occurrences         PetCareOccurrence[]
  events              PetCareEvent[]
  reminderDeliveries  PetReminderDelivery[]

  @@unique([petId, clientRequestId])
  @@index([userId, petId, status])
  @@index([petId, nextDueOn])
}

/// Phase 4 architecture adjustment — stable occurrence identity for Phase 5 reminders.
/// Virtual until complete/skip; then persisted. Skip is not an administration event.
model PetCareOccurrence {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  scheduleId      String
  schedule        PetCareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  revision        Int
  plannedOn       String
  plannedTime     String?
  sequence        Int
/// r{revision}|{plannedOn}|{plannedTime||date}|{sequence}
  occurrenceKey   String
  /// OPEN | ADMINISTERED | SKIPPED | CANCELLED
  status          String    @default("OPEN")
  eventId         String?   @unique
  event           PetCareEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  skipNote        String?
  skippedAt       DateTime?
  clientRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scheduleId, occurrenceKey])
  @@unique([petId, clientRequestId])
  @@index([petId, plannedOn])
  @@index([scheduleId, status])
}

/// Phase 4 — what actually happened. Snapshots survive later product/schedule edits.
model PetCareEvent {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId               String
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  kind                String
  productId           String?
  product             PetProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  scheduleId          String?
  schedule            PetCareSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  titleSnapshot       String
  productNameSnapshot String?
  doseSnapshot        String?
  doseUnitSnapshot    String?
  routeSnapshot       String?
  administeredOn      String
  administeredTime   String?
  timezone            String?
  utcOffsetMinutes    Int?
  notes               String?
  /// RECORDED | VOIDED
  status              String    @default("RECORDED")
  voidedAt            DateTime?
  voidReason          String?
  correctionMeta      Json?
  previousNextDueOn   String?
  /// app | notification (Phase 5)
  source              String    @default("app")
  idempotencyHash     String?
  clientRequestId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  occurrence          PetCareOccurrence?

  @@unique([petId, clientRequestId])
  @@index([userId, petId, administeredOn])
  @@index([scheduleId])
}

/// Phase 5 — honest local-reminder telemetry. Not proof of OS banner display.
model PetReminderDelivery {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  scheduleId    String
  schedule      PetCareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  occurrenceKey String
  alertKind     String
  identity      String
  installId     String
  /// SCHEDULED_LOCAL | SCHEDULE_FAILED | CANCELLED | RECEIVED_CALLBACK | USER_RESPONSE | COMPLETION_CONFIRMED
  status        String
  fireAtMs      BigInt?
  createdAt     DateTime @default(now())

  @@index([userId, identity])
  @@index([petId, createdAt])
  @@index([userId, status, createdAt])
}

/// Phase 6 — Medi Vet conversation. Isolated from human ChatSession JSON.
model PetChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  title     String   @default("ახალი საუბარი")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  PetChatMessage[]

  @@index([userId, petId, updatedAt])
  @@index([petId, updatedAt])
}

/// Phase 6 — per-turn storage. Roles are server-controlled. Never store client system/assistant fabrications.
model PetChatMessage {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  sessionId       String
  session         PetChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// user | assistant
  role            String
  content         String         @default("")
  /// PENDING | PARTIAL | COMPLETE | FAILED | CANCELLED
  status          String         @default("COMPLETE")
  clientRequestId String?
  citations       Json?
  draft           Json?
  grounding       Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sessionId, clientRequestId])
  @@index([sessionId, createdAt])
  @@index([petId, createdAt])
  @@index([userId, petId, status])
}

