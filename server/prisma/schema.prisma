datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  fullName         String
  phone            String?              @unique
  gender           String? // 'MALE' | 'FEMALE' | 'OTHER'
  birthDate        DateTime?            @db.Date
  /// ACTIVE | BLOCKED
  status           String               @default("ACTIVE")
  packageId        String?
  package          Package?             @relation(fields: [packageId], references: [id])
  /// Start of the current paid billing period (30-day window from purchase/renewal).
  packageStartedAt DateTime?
  packageExpiresAt DateTime?
  adminNote        String?
  /// Daily login bonus — 5 points per calendar day (Asia/Tbilisi).
  points           Int                  @default(0)
  currentStreak    Int                  @default(0)
  longestStreak    Int                  @default(0)
  lastCheckInDate  DateTime?            @db.Date
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  records          MedicalRecord[]
  checkIns         DailyCheckIn[]
  pointAwards      PointAward[]
  chats            ChatSession[]
  medications      MedicationSchedule[]
  periodUsages     PeriodUsage[]
  pushTokens       PushToken[]
  pushEvents       PushEvent[]
  cycleProfile     CycleProfile?
  cycleLogs        CycleLog[]
  cycleCustomTags  CycleCustomTag[]
  pregnancyLogs    PregnancyLog[]
  cycleSharesOwned    CyclePartnerShare[] @relation("CycleShareOwner")
  cycleSharesAccepted CyclePartnerShare[] @relation("CycleSharePartner")
  aiInteractions   AiInteraction[]
  aiFeedback       AiFeedback[]
  doctorVisits     DoctorVisit[]
  healthProfile    HealthProfile?
  healthMetricDaily HealthMetricDaily[]
  stepLogs         StepLog[]
  notificationDecisions NotificationDecision[]
  appActivities         AppActivity[]
  notificationOutcomes  NotificationOutcome[]
  productEvents         ProductEvent[]
  medicationDoseEvents  MedicationDoseEvent[]
  notificationPermission NotificationPermission?
  userQuests            UserQuest[]
  questCompletions      QuestCompletion[]
  rewardLedger          RewardLedger[]
  questProfile          UserQuestProfile?
  hydrationPreference   HydrationPreference?
  hydrationIntakeEvents HydrationIntakeEvent[]
  stepTrackingCapability StepTrackingCapability?

  @@index([status])
  @@index([packageId])
  @@index([createdAt])
  @@index([lastCheckInDate])
  passwordResets    PasswordReset[]
}

/// One row per user per Tbilisi calendar day. Unique constraint makes the claim idempotent.
model DailyCheckIn {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  pointsAwarded Int      @default(5)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Idempotent bonus ledger — steps goal, future rewards.
model PointAward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  ref       String
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, kind, ref])
  @@index([userId])
}

/// Email OTP for password recovery — 6-digit code, short TTL.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

/// SMS OTP for phone verification — 4-digit code, short TTL.
model PhoneVerification {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String    @default("AUTH") // AUTH | LINK | ADMIN
  userId    String?
  reference String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([userId])
  @@index([expiresAt])
  @@index([reference])
}

/// Outbound SMS audit log (SMSOffice.ge and admin sends).
model SmsLog {
  id           String   @id @default(uuid())
  destination  String
  content      String
  sender       String   @default("MEDICARD")
  purpose      String   @default("OTP") // OTP | ADMIN | MARKETING | TEST
  reference    String?
  status       String   @default("QUEUED") // QUEUED | SENT | FAILED
  providerCode Int?
  providerMsg  String?
  userId       String?
  adminId      String?
  createdAt    DateTime @default(now())

  @@index([destination])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
}

/// Comprehensive health assessment data collected after registration.
model HealthProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm               Float?
  weightKg               Float?
  bloodType              String?
  activityLevel          String?
  exerciseFrequency      String?
  sleepQuality           String?
  sleepHours             Float?
  stressLevel            String?
  smokingStatus          String?
  alcoholUse             String?
  dietType               String?
  waterIntakeL           Float?
  restingHeartRate       Int?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  /// string[] — e.g. diabetes, hypertension
  chronicConditions      Json      @default("[]")
  /// string[]
  allergies              Json      @default("[]")
  /// string[]
  medications            Json      @default("[]")
  /// string[]
  familyHistory          Json      @default("[]")
  /// string[]
  healthGoals            Json      @default("[]")
  /// Extra step answers keyed by assessment step id
  extraAnswers           Json      @default("{}")
  currentStepIndex       Int       @default(0)
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// Idempotent in-app hydration intake. Daily total is the sum of these events.
model HydrationIntakeEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientEventId String
  /// YYYY-MM-DD
  date          String
  deltaMl       Int
  createdAt     DateTime @default(now())

  @@unique([userId, clientEventId])
  @@index([userId, date])
}

/// Privacy-safe step-tracking capability. No device hardware identifiers.
model StepTrackingCapability {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AVAILABLE | UNAVAILABLE | PERMISSION_DENIED | NOT_CONFIGURED | UNKNOWN
  status    String
  /// APPLE_HEALTH | HEALTH_CONNECT | OTHER | UNKNOWN
  source    String   @default("UNKNOWN")
  updatedAt DateTime @updatedAt
}

/// User-chosen hydration goal for the app. Not a medical prescription.
model HydrationPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalMl    Int
  updatedAt DateTime @updatedAt
}

/// Daily health aggregates synced from device (Apple Health / Health Connect).
model HealthMetricDaily {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD calendar day (user-local when synced from mobile)
  date                   String
  steps                  Int?
  weightKg               Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Float?
  sleepHours             Float?
  nutritionKcal          Float?
  hydrationMl            Float?
  activeMinutes          Int?
  distanceKm             Float?
  /// device | manual | merged
  source                 String   @default("device")
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Individual step samples synced from device health apps.
model StepLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  stepCount  Int
  source     String   @default("device")
  createdAt  DateTime @default(now())

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

/// Women's health — one profile per user (FEMALE-gated in API)
model CycleProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TRACK_PERIOD | TRY_TO_CONCEIVE | PREGNANCY
  mode             String    @default("TRACK_PERIOD")
  avgCycleLength   Int       @default(28)
  avgPeriodLength  Int       @default(5)
  lastPeriodStart  DateTime? @db.Date
  isIrregular      Boolean   @default(false)
  dueDate          DateTime? @db.Date
  /// Local privacy — client enforces; stored hash optional
  privacyEnabled   Boolean   @default(false)
  partnerShareCode String?   @unique
  /// Cached Flo-style AI recommendations (JSON)
  aiInsights       Json?
  aiInsightsAt     DateTime?
  /// e.g. ["pcos","endometriosis","perimenopause"]
  conditions       Json      @default("[]")
  /// Optional mirror of mobile reminder prefs for cross-device sync
  reminderPrefs    Json?
  /// Current method only. null = never asked; NONE = explicit no method.
  contraceptionMethod     String?
  contraceptionStartedAt  DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CycleLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD (Asia/Tbilisi calendar day)
  date            String
  /// none | spotting | light | medium | heavy
  flow            String?
  /// string[] symptom keys
  symptoms        Json     @default("[]")
  /// string[] mood keys
  moods           Json     @default("[]")
  sexualActivity  Boolean?
  libido          Int? // 1-5
  bbt             Float?
  /// dry | sticky | creamy | watery | eggwhite
  cervicalMucus   String?
  /// negative | positive | unclear — user-logged OPK result, not confirmed ovulation
  ovulationTest   String?
  /// negative | positive | unclear — user-logged pregnancy-test result, not a diagnosis
  pregnancyTest   String?
  notes           String?
  /// [{ type, severity }] — user-logged. Does not change predictions.
  painEntries     Json     @default("[]")
  /// poor | okay | good
  sleepQuality    String?
  /// low | medium | high
  stressLevel     String?
  /// none | light | moderate | intense
  exerciseLevel   String?
  /// none | low | moderate | high
  caffeine        String?
  /// none | light | moderate | heavy
  alcohol         String?
  /// CycleCustomTag ids for this calendar day
  customTagIds    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

/// User-owned Cycle labels. Archive instead of hard-delete.
model CycleCustomTag {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  @@index([userId, archivedAt])
  @@index([userId, nameNormalized])
}

/// One active invite per owner in product UI. Token hash is looked up; plaintext is owner-only.
model CyclePartnerShare {
  id            String    @id @default(uuid())
  ownerUserId   String
  owner         User      @relation("CycleShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  partnerUserId String?
  partner       User?     @relation("CycleSharePartner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  /// SHA-256 hex of the invite token
  tokenHash     String    @unique
  /// period | cyclePhase | fertileWindow | symptoms
  permissions   Json
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([ownerUserId])
  @@index([partnerUserId])
}

model PregnancyLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  currentWeek Int?
  weightKg    Float?
  symptoms    Json     @default("[]")
  kickCount   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Package {
  id            String   @id @default(uuid())
  /// FREE | STANDARD | ULTIMATE
  code          String   @unique
  nameKa        String
  nameEn        String
  descriptionKa String
  /// Monthly equivalent for marketing / admin (-1 = unlimited). Metering uses dailyAiLimit.
  monthlyAiLimit Int      @default(90)
  /// Consume cap per rolling window. After the user hits this, resetAt is now + 24h.
  dailyAiLimit  Int       @default(3)
  priceGel      Float     @default(0)
  /// JSON feature flags / module access
  features      Json
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  pushCampaigns PushCampaign[]
  aiEvalRuns    AiEvalRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Singleton row id = "default"
model AppSettings {
  id                 String   @id @default("default")
  /// When true, mobile/API refuse non-admin traffic with maintenance message
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("აპლიკაცია დროებით განახლების რეჟიმშია. გთხოვთ, სცადოთ მოგვიანებით.")
  /// Soft gate: clients below this see an update prompt
  minAppVersion      String   @default("1.0.0")
  /// Hard gate: clients below minAppVersion cannot use the API
  forceUpdate        Boolean  @default(false)
  allowRegistrations Boolean  @default(true)
  supportEmail       String   @default("support@medicard.ge")
  /// When true, phone OTP 0000 and email reset 000000 always verify. Turn off after QA.
  qaOtpEnabled       Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model PeriodUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Billing period key — rolling daily (roll:daily), calendar month (cal:YYYY-MM), or subscription (sub:start:end).
  periodKey String
  count     Int      @default(0)
  /// When the daily cap is hit, countdown starts here (typically now + 24h). Null while under the cap.
  resetAt   DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, periodKey])
  @@index([userId])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // ios | android | web
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, active])
}

/// Audit log for every AI call — foundation for quality engine and admin review.
model AiInteraction {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DOCTOR | CONSILIUM | LAB | IMAGING | SKIN | SKINCARE | MEDICATION | CYCLE_WELLNESS | SYMPTOM_CHECKER
  mode            String
  status          String         @default("OK") // OK | ERROR
  errorMessage    String?
  promptVersion   String         @default("1.0.0")
  chatSessionId   String?
  medicalRecordId String?
  userPrompt      String?
  assistantReply  String?
  visionProvider  String?
  visionModel     String?
  reasoningModel  String?
  latencyMs       Int?
  tokenUsage      Json?
  createdAt       DateTime       @default(now())
  feedback        AiFeedback[]
  evalResults     AiEvalResult[]

  @@index([userId, createdAt])
  @@index([mode, createdAt])
  @@index([status, createdAt])
}

model AiFeedback {
  id            String        @id @default(uuid())
  interactionId String
  interaction   AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 = helpful, -1 = not helpful
  rating        Int
  comment       String?
  createdAt     DateTime      @default(now())

  @@unique([interactionId, userId])
  @@index([rating, createdAt])
}

model AiEvalRun {
  id            String         @id @default(uuid())
  status        String         @default("RUNNING") // RUNNING | DONE | FAILED
  sampleSize    Int            @default(0)
  avgScore      Float?
  lowScoreCount Int            @default(0)
  summary       String?
  triggeredById String?
  triggeredBy   Admin?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?
  results       AiEvalResult[]

  @@index([createdAt])
}

model AiEvalResult {
  id            String         @id @default(uuid())
  runId         String
  run           AiEvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  interactionId String?
  interaction   AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  mode          String
  score         Int
  passed        Boolean
  rubric        Json
  notes         String?
  sourceType    String         @default("interaction")
  sourceId      String?
  createdAt     DateTime       @default(now())

  @@index([runId])
  @@index([score])
}

/// Admin-editable Medi copy. Missing row = code default.
model PushTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

/// Local / QA / device-received notifications. Broadcasts stay on PushCampaign.
model PushEvent {
  id        String   @id @default(uuid())
  source    String
  key       String
  title     String
  body      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([key])
}

model PushCampaign {
  id          String    @id @default(uuid())
  title       String
  body        String
  data        Json?
  /// ALL | FREE | STANDARD | ULTIMATE | ACTIVE
  segment     String    @default("ALL")
  status      String    @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  targetCount Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String?
  createdBy   Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model DailyUsage {
  id        String   @id @default(uuid())
  userId    String
  date      String // Format: YYYY-MM-DD — legacy, superseded by PeriodUsage
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model MedicalRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // 'LAB', 'XRAY', 'CT_MRI', 'SKIN', 'SKINCARE', 'PRESCRIPTION', 'SYMPTOM'
  imageUrl   String?
  aiAnalysis String // JSON or Markdown string in Georgian
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("ახალი საუბარი")
  mode      String   @default("DOCTOR") // 'DOCTOR' | 'CONSILIUM'
  messages  Json // Array of message objects { role, content, timestamp }
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId, updatedAt])
}

model MedicationSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medName   String
  dosage    String
  frequency String // e.g., '09:00, 15:00, 21:00'
  notes     String?
  active    Boolean  @default(true)
  /// pill shape/color, days of week, refill settings, form type, dates, etc.
  config    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, active])
}

/// Scheduled doctor visit with optional location and local notification rules.
model DoctorVisit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GP | DENTIST | CARDIO | GYN | NEURO | ORTHO | THERAPIST | OPHTHALMO | DERM | PED | OTHER
  doctorType      String
  doctorFirstName String?
  doctorLastName  String?
  /// YYYY-MM-DD local calendar day
  visitDate       String
  /// HH:mm 24h
  visitTime       String
  address         String?
  addressLabel    String?
  lat             Float?
  lng             Float?
  notes           String?
  /// { enabled, offsetsMinutes: number[], repeatCount: number }
  reminderConfig  Json     @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, visitDate])
  @@index([userId, active])
}

/// Pharmacy chain (Pharmadepot, Aversi, PSP)
model PharmacySource {
  id        String          @id // PHARMADEPOT | AVERSI | PSP
  nameKa    String
  logoUrl   String?
  baseUrl   String
  offers    PharmacyOffer[]
  bestFor   CatalogProduct[] @relation("BestSource")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// Unified medication category tree
model DrugCategory {
  id          String              @id @default(uuid())
  slug        String              @unique
  nameKa      String
  iconUrl     String?
  parentId    String?
  parent      DrugCategory?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    DrugCategory[]      @relation("CategoryTree")
  sortOrder   Int                 @default(0)
  products    CatalogProduct[]
  sourceMaps  SourceCategoryMap[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([parentId, sortOrder])
}

/// Maps external category ids to unified DrugCategory
model SourceCategoryMap {
  id             String       @id @default(uuid())
  source         String // PHARMADEPOT | AVERSI | PSP
  sourceCategory String
  categoryId     String
  category       DrugCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([source, sourceCategory])
  @@index([categoryId])
}

/// Canonical product matched across pharmacies
model CatalogProduct {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  normalizedKey  String
  imageUrl       String?
  manufacturer   String?
  country        String?
  form           String?
  strength       String?
  packSize       String?
  description    String?
  categoryId     String?
  category       DrugCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bestPriceGel   Float?
  bestSourceId   String?
  bestSource     PharmacySource? @relation("BestSource", fields: [bestSourceId], references: [id], onDelete: SetNull)
  offerCount     Int             @default(0)
  lastSyncedAt   DateTime?
  offers         PharmacyOffer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([normalizedKey])
  @@index([categoryId])
  @@index([bestPriceGel])
  @@index([name])
}

/// Per-pharmacy listing for a catalog product
model PharmacyOffer {
  id               String         @id @default(uuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  sourceId         String
  source           PharmacySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceProductId  String
  sourceUrl        String
  rawName          String
  priceGel         Float
  oldPriceGel      Float?
  discountPercent  Float?
  inStock          Boolean        @default(true)
  imageUrl         String?
  syncedAt         DateTime       @default(now())

  @@unique([sourceId, sourceProductId])
  @@unique([catalogProductId, sourceId])
  @@index([catalogProductId, priceGel])
  @@index([syncedAt])
}

/// Sync job audit log
model SyncRun {
  id           String    @id @default(uuid())
  source       String // PHARMADEPOT | AVERSI | PSP | ALL
  status       String    @default("RUNNING") // RUNNING | DONE | FAILED
  itemsFetched Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, startedAt])
}

/// One authenticated app-open per Tbilisi day. DAU/WAU/MAU source. Not a login bonus.
model AppActivity {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  firstAt      DateTime
  lastAt       DateTime
  platform     String?
  appVersion   String?
  activityType String   @default("open")

  @@unique([userId, date])
  @@index([date])
  @@index([lastAt])
  @@index([appVersion])
}

/// Sanitized Brain outcomes. No titles, bodies, health values, or chat.
model NotificationOutcome {
  id         String   @id @default(uuid())
  decisionId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome    String
  actionKey  String   @default("")
  occurredAt DateTime
  appVersion String?
  platform   String?
  implied    Boolean  @default(false)
  syncedAt   DateTime @default(now())

  @@unique([decisionId, outcome, actionKey])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([outcome, occurredAt])
}

model ProductEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  category   String?
  entityId   String?
  source     String?
  occurredAt DateTime
  appVersion String?
  platform   String?

  @@unique([userId, kind, entityId])
  @@index([kind, occurredAt])
}

model MedicationDoseEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String
  date         String
  time         String
  status       String
  source       String
  occurredAt   DateTime

  @@unique([userId, medicationId, date, time])
  @@index([date])
}

model NotificationPermission {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  platform  String?
  updatedAt DateTime
}

/// Sanitized Notification Brain decisions synced from devices. No health values, no chat text.
model NotificationDecision {
  id                String    @id
  decisionId        String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate         String
  family            String
  score             Int       @default(0)
  /// SEND | BLOCKED | CANCELLED | REVALIDATED
  result            String
  reason            String?
  templateKey       String?
  route             String?
  selectedFrequency String?
  baseDailyCap      Int?
  adaptiveDailyCap  Int?
  ewma              Float?
  createdAt         DateTime
  scheduledAt       DateTime?
  revalidatedAt     DateTime?
  syncedAt          DateTime  @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([family, createdAt])
  @@index([userId, createdAt])
}

/// Reusable Medi Quest definition. Config must never contain health notes or PII.
model QuestTemplate {
  id             String    @id @default(uuid())
  key            String    @unique
  /// MOVEMENT | HYDRATION | MEDI | WEATHER | WELLNESS
  category       String
  /// DAILY | WEEKLY | EVENT
  cadence        String
  titleKey       String
  descriptionKey String
  /// STEPS | HYDRATION_GOAL_PERCENT | MEDI_DAILY_USE | COUNT
  progressType   String
  defaultTarget  Int
  rewardCoins    Int       @default(0)
  rewardXp       Int       @default(0)
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  startAt        DateTime?
  endAt          DateTime?
  /// Non-sensitive quest configuration only (metric key, window). Never health notes.
  config         Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignments    UserQuest[]

  @@index([isActive, cadence, priority])
}

/// Concrete quest assignment for one user and one local period.
model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestTemplate @relation(fields: [templateId], references: [id])
  /// Local calendar day `YYYY-MM-DD` or ISO week `YYYY-Www`.
  periodKey   String
  target      Int
  progress    Int       @default(0)
  /// ACTIVE | COMPLETED | CLAIMED | EXPIRED | CANCELLED
  status      String    @default("ACTIVE")
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime
  /// Safe operational values only — never health notes, med names, symptoms, chat.
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completions QuestCompletion[]

  @@unique([userId, templateId, periodKey])
  @@index([userId, status])
  @@index([userId, periodKey])
  @@index([expiresAt])
}

/// Immutable quest completion. Unique on userQuestId — never complete twice.
model QuestCompletion {
  id                   String   @id @default(uuid())
  userQuestId          String   @unique
  userQuest            UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt          DateTime @default(now())
  progressAtCompletion Int
  /// sync | claim | system
  source               String
  createdAt            DateTime @default(now())

  @@index([userId, completedAt])
}

/// Immutable reward ledger. Authoritative for XP and coins. Unique per payee/currency/source.
model RewardLedger {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// XP | COIN
  currency        String
  amount          Int
  /// EARN | ADJUST
  transactionType String
  /// QUEST | SYSTEM
  sourceType      String
  sourceId        String
  createdAt       DateTime @default(now())
  metadata        Json?

  @@unique([userId, currency, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([userId, currency])
}

/// Cached quest profile. Ledger remains authoritative for XP and coins.
model UserQuestProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel        Int      @default(1)
  totalXp             Int      @default(0)
  cachedCoinBalance   Int      @default(0)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  lastActiveQuestDate String?
  /// IANA timezone, e.g. Europe/Brussels. Legacy fallback is Asia/Tbilisi.
  timezone            String?
  lastDailyAssignPeriodKey String?
  lastDailyAssignAt   DateTime?
  updatedAt           DateTime @updatedAt
}

/// Admin actions — template edits, settings, user status. Never store secrets.
model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String?
  adminEmail    String
  action        String
  targetType    String
  targetId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}
