# Default: production (Render). No local server needed for login/auth in Expo Go.
EXPO_PUBLIC_API_URL=https://medicard.ge

# Isolated თბილისი მოძრაობს owner-pilot API (development build / phone LAN).
# Copy the printed LAN URL from `node scripts/tbilisi-moves-pilot.mjs`.
# A phone's localhost is not the development PC.
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4011
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:4011

# Local server only when testing API changes on your PC (same Wi‑Fi as phone):
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000

# Mapbox public token (pk.*) — powers the Run (beta) 3D map + Directions pin generation.
# Installed EAS builds also fetch this at runtime from GET /api/app/status (same pk.* as MAPBOX_PUBLIC_TOKEN).
# For native builds you can still set an EAS secret: eas secret:create --name EXPO_PUBLIC_MAPBOX_TOKEN --value pk....
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
