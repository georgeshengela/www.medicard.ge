                "accessoryInline"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
