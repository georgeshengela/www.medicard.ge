{
  "expo": {
    "name": "MEDICARD",
    "slug": "medicard-ge",
    "scheme": "medicard",
    "version": "25.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14B8A6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.medicard.app",
      "infoPlist": {
        "CFBundleDisplayName": "MEDICARD",
        "NSCameraUsageDescription": "კამერა საჭიროა ანალიზების, რენტგენისა და კანის ფოტოს გადასაღებად.",
        "NSPhotoLibraryUsageDescription": "გალერეაზე წვდომა საჭიროა სამედიცინო დოკუმენტებისა და ფოტოების ასატვირთად.",
        "NSMicrophoneUsageDescription": "მიკროფონი საჭიროა ხმის ანალიზისთვის, თუ ამ ნაბიჯს გაივლით.",
        "NSFaceIDUsageDescription": "Medicard-ს Face ID სჭირდება ანგარიშისა და ციკლის მონაცემების დასაცავად.",
        "NSLocationWhenInUseUsageDescription": "Medicard-ს ლოკაცია სჭირდება თქვენი ქალაქისა და ქვეყნის ამოსაცნობად და პროფილზე საცხოვრებელი ადგილის საჩვენებლად.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ge.medicard.app",
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.WRITE_MENSTRUATION",
        "android.permission.health.READ_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.WRITE_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_CERVICAL_MUCUS",
        "android.permission.health.WRITE_CERVICAL_MUCUS",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14B8A6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Medicard-ს სჭირდება გალერეაზე წვდომა ანალიზებისა და ფოტოების ასატვირთად.",
          "cameraPermission": "Medicard-ს სჭირდება კამერაზე წვდომა სამედიცინო ფოტოს გადასაღებად."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14B8A6",
          "defaultChannel": "medication-reminders"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Medicard-ს Apple Health-ის წაკითხვა სჭირდება წონის, წნევის, პულსის, ძილისა და ჰიდრატაციის სინქრონიზაციისთვის.",
          "NSHealthUpdateUsageDescription": "Medicard-ს Apple Health-ში ციკლისა და ჯანმრთელობის ჩანაწერების შენახვა სჭირდება.",
          "background": false
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "softwareKeyboardLayoutMode": "resize"
          }
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Medicard-ს ლოკაცია სჭირდება თქვენი ქალაქისა და ქვეყნის ამოსაცნობად და პროფილზე საცხოვრებელი ადგილის საჩვენებლად."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Medicard-ს Face ID სჭირდება ანგარიშისა და ციკლის მონაცემების დასაცავად."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "apiUrl": "https://medicard.ge",
      "privacyPolicyUrl": "https://medicard.ge/privacy",
      "termsOfServiceUrl": "https://medicard.ge/terms",
      "supportEmail": "support@medicard.ge",
      "eas": {
        "projectId": "7dd7dc9b-9e05-4e8c-a26e-8fc6800dc492"
      }
    }
  }
}
