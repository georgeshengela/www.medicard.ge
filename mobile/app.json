{
  "expo": {
    "name": "MEDICARD AI",
    "slug": "medicard-ge",
    "scheme": "medicard",
    "version": "1.0.0.26.1",
    "assetBundlePatterns": [
      "assets/**"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14B8A6",
    "locales": {
      "en": "./locales/en.json",
      "ka": "./locales/ka.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.medicard.app",
      "usesAppleSignIn": true,
      "version": "1.11.30",
      "buildNumber": "41",
      "infoPlist": {
        "CFBundleDisplayName": "MEDICARD AI",
        "NSCameraUsageDescription": "MEDICARD AI uses the camera to scan meals, food labels and barcodes for your food diary, to photograph lab results, X-rays, skin and pets, for your profile photo, MEDICOACH progress photos and trainer certificate, to read QR codes, and to find virtual gifts in MEDIRUN.",
        "NSPhotoLibraryUsageDescription": "MEDICARD AI needs access to your photos to upload the meal photos, medical documents, pet photos, profile photo, MEDICOACH progress photos, trainer certificate and women's space post photos that you choose.",
        "NSMicrophoneUsageDescription": "The microphone is used only when you choose to, for the voice assistant and voice analysis.",
        "NSFaceIDUsageDescription": "MEDICARD AI uses Face ID to protect your account and cycle data.",
        "NSLocationWhenInUseUsageDescription": "MEDICARD AI uses your location for your city and weather, to show places near you on the MEDIBOOK map, and in MEDIRUN to record the route you walk and find gifts nearby. A MEDIRUN session you start keeps recording your route after the screen locks (a blue indicator shows at the top) until you tap Pause or Finish.",
        "NSCalendarsUsageDescription": "Calendar access is needed to add the entries you choose to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Calendar access is needed to add the entries you choose to your calendar.",
        "UIBackgroundModes": [
          "remote-notification",
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "MEDISLEEP uses alarms to wake you at the time you chose in sleep mode, even in silent mode and when the app is closed."
      }
    },
    "android": {
      "package": "ge.medicard.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 92,
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.WRITE_MENSTRUATION",
        "android.permission.health.READ_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.WRITE_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_CERVICAL_MUCUS",
        "android.permission.health.WRITE_CERVICAL_MUCUS",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6EFED",
          "image": "./assets/splash/launch-light.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#132A34",
            "image": "./assets/splash/launch-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MEDICARD AI uses the camera to scan meals, food labels and barcodes for your food diary, to photograph lab results, X-rays, skin and pets, for your profile photo, MEDICOACH progress photos and trainer certificate, to read QR codes, and to find virtual gifts in MEDIRUN."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MEDICARD AI needs access to your photos to upload the meal photos, medical documents, pet photos, profile photo, MEDICOACH progress photos, trainer certificate and women's space post photos that you choose.",
          "cameraPermission": "MEDICARD AI uses the camera to scan meals, food labels and barcodes for your food diary, to photograph lab results, X-rays, skin and pets, for your profile photo, MEDICOACH progress photos and trainer certificate, to read QR codes, and to find virtual gifts in MEDIRUN."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14B8A6",
          "defaultChannel": "medication-reminders",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sleep/medisleep_dawn.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Calendar access is needed to add the entries you choose to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "MEDICARD AI reads Apple Health to sync steps, weight, blood pressure, heart rate, sleep, nutrition, hydration, cycle and workouts (duration, calories, heart rate) and, if you turn it on in cycle settings, basal and sleeping wrist temperature to estimate ovulation retrospectively. If you turn it on, activity and workouts are shared with the trainer you chose in MEDICOACH. It is never used for advertising.",
          "NSHealthUpdateUsageDescription": "MEDICARD AI saves to Apple Health for the sync you turn on: cycle entries (period, spotting, BBT, cervical mucus) and the calories, protein, carbs and fat from your food diary.",
          "background": false
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "softwareKeyboardLayoutMode": "resize"
          }
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MEDICARD AI uses your location for your city and weather, to show places near you on the MEDIBOOK map, and in MEDIRUN to record the route you walk and find gifts nearby. A MEDIRUN session you start keeps recording your route after the screen locks (a blue indicator shows at the top) until you tap Pause or Finish.",
          "locationAlwaysAndWhenInUsePermission": "MEDICARD AI uses your location in the background only during a MEDIRUN session you started, to record your route while the screen is locked. Outside a session no location is collected in the background.",
          "locationAlwaysPermission": "MEDICARD AI uses your location in the background only during a MEDIRUN session you started, to record your route while the screen is locked. Outside a session no location is collected in the background.",
          "motionUsagePermission": "MEDICARD AI uses the motion sensors to show a virtual gift in the right place in the camera view in MEDIRUN.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/android-icon-monochrome.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MEDICARD AI uses Face ID to protect your account and cycle data."
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is used only when you choose to, for the voice assistant and voice analysis.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "ge.medicard.app.widgets",
          "groupIdentifier": "group.ge.medicard.app",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "MedicardCycle",
              "displayName": "MEDICARD ციკლი",
              "description": "მენსტრუაციამდე დარჩენილი დღეები · Days until your period",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
