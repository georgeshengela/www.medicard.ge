            },
            {
              "name": "MedicardSleep",
              "displayName": "MEDISLEEP",
              "description": "დაწოლის დრო, ბოლო ღამე და ძილის რეჟიმი · Bedtime, last night and sleep mode",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular",
